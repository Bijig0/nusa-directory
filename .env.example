# Copy to .env for local development. In Vercel, add each of these under Project → Settings → Environment Variables.

ENVIRONMENT=development                  # production on Vercel
PUBLIC_SITE_URL=http://localhost:4321    # https://your-domain on Vercel

# Turso (https://turso.tech): `turso db create nusa && turso db show nusa --url && turso db tokens create nusa`
# Locally an embedded SQLite file is used when TURSO_DATABASE_URL starts with file:
TURSO_DATABASE_URL=file:.data/dev.db
TURSO_AUTH_TOKEN=

# Cloudflare R2 over the S3 API (Cloudflare dashboard → R2 → Manage API tokens, "Object Read & Write").
# Leave empty locally to store photos on disk under .data/photos/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=escort-directory-photos

# Random 32+ byte strings: openssl rand -base64 48
DEVICE_SECRET=dev-device-secret-change-me-please-0123456789
OTP_PEPPER=dev-otp-pepper-change-me-please-0123456789
CRON_SECRET=dev-cron-secret-change-me
SEED_TOKEN=dev-seed-token                # dev; on Vercel set temporarily for the one-time taxonomy setup, then remove
DEV_EXPOSE_OTP=true                      # dev only; omit on Vercel

# Comma-separated E.164 phones and/or emails that get the admin role on sign-in.
ADMIN_IDENTITIES=+6281200000001,admin@example.com

# Midtrans (https://dashboard.midtrans.com → Settings → Access Keys). Placeholder keys enable dev auto-paid orders.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# Fonnte WhatsApp gateway (https://fonnte.com). Empty = OTPs logged to the console.
FONNTE_TOKEN=
# Resend (https://resend.com). Empty = emails logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Nusa Directory <no-reply@example.com>
# Google OAuth 2.0 web client; redirect URI {PUBLIC_SITE_URL}/auth/google/callback. Empty = button hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
