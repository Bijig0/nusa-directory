---
import Base from './Base.astro';
import { translate } from '../domain/i18n';
import { site } from '../../site.config';

interface Props { title: string; active: string }
const { title, active } = Astro.props;
const t = translate(Astro.locals.dict);
const nav = [
  ['dashboard', '/admin/', t('admin.dashboard')], ['listings', '/admin/listings/', t('admin.listings')], ['reports', '/admin/reports/', t('admin.reports')],
  ['reviews', '/admin/reviews/', t('admin.reviews')], ['users', '/admin/users/', t('admin.users')], ['orders', '/admin/orders/', t('admin.orders')],
  ['products', '/admin/products/', t('admin.products')], ['geo', '/admin/geo/', t('admin.geo')],
] as const;
const result = Astro.url.searchParams.get('done');
---
<Base title={`${title} | ${t('admin.title')} · ${site.name}`} description={title} path="/admin/" noindex noAgeGate>
  <div class="container-page py-6">
    <nav class="mb-4 flex gap-1 overflow-x-auto border-b border-zinc-200 pb-2 text-sm dark:border-zinc-800" aria-label={t('admin.title')}>
      {nav.map(([key, href, label]) => (
        <a href={href} class={`shrink-0 rounded-lg px-3 py-1.5 ${active === key ? 'bg-brand-600 text-white' : 'hover:bg-zinc-100 dark:hover:bg-zinc-800'}`}>{label}</a>
      ))}
      <a href="/dashboard/" class="ml-auto shrink-0 rounded-lg px-3 py-1.5 text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800">← {t('dash.title')}</a>
    </nav>
    <h1 class="mb-4 text-2xl font-black tracking-tight">{title}</h1>
    {result && <p class="mb-3 rounded bg-emerald-50 p-2 text-sm text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-200">✓ {result}</p>}
    <slot />
  </div>
</Base>
