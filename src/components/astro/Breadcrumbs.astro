---
import type { Crumb } from '../../domain/seo';
interface Props { crumbs: readonly Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-xs text-zinc-500">
  <ol class="flex flex-wrap items-center gap-1">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === crumbs.length - 1 ? <span aria-current="page" class="text-zinc-700 dark:text-zinc-300">{c.name}</span> : <a href={c.url} class="hover:text-brand-600">{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
