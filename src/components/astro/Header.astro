---
import { site } from '../../../site.config';
import { translate, localizedPath, splitLocale } from '../../domain/i18n';
const { locale, dict } = Astro.locals;
const t = translate(dict);
const { path } = splitLocale(Astro.url.pathname);
const otherLocale = locale === 'id' ? 'en' : 'id';
const home = localizedPath(locale, '/');
---
<header class="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/90">
  <div class="container-page flex h-14 items-center justify-between gap-3">
    <a href={home} class="flex items-center gap-2 text-lg font-black tracking-tight">
      <span class="inline-block h-7 w-7 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700"></span>
      <span>{site.name}</span>
    </a>
    <nav class="flex items-center gap-1 text-sm" aria-label="Main">
      <a href={localizedPath(locale, '/favorites/')} class="btn-ghost hidden sm:inline-flex" title={t('nav.favorites')}>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        <span class="sr-only">{t('nav.favorites')}</span>
      </a>
      <a href={localizedPath(otherLocale, path)} class="btn-ghost text-xs uppercase" rel="alternate" hreflang={otherLocale} title={t('lang.switch')}>{otherLocale}</a>
      <a href="/dashboard/" class="btn-secondary" hidden data-when-signed-in>{t('nav.dashboard')}</a>
      <a href="/auth/login/" class="btn-ghost" data-when-signed-out>{t('nav.login')}</a>
      <a href="/dashboard/listings/new/" class="btn-primary">{t('nav.post')}</a>
    </nav>
  </div>
</header>
<script>
  // Public pages are cached for everyone, so the signed-in state is toggled client-side from a non-sensitive marker cookie.
  const signedIn = document.cookie.split('; ').some((c) => c === 'li=1');
  document.querySelectorAll<HTMLElement>('[data-when-signed-in]').forEach((el) => (el.hidden = !signedIn));
  document.querySelectorAll<HTMLElement>('[data-when-signed-out]').forEach((el) => (el.hidden = signedIn));
</script>
