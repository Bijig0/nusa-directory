---
import { site } from '../../../site.config';
import { translate, localizedPath } from '../../domain/i18n';
import { citySeeds } from '../../data/cities';
import { categorySeeds } from '../../data/categories';
const { locale, dict } = Astro.locals;
const t = translate(dict);
const cities = citySeeds.slice(0, 12);
const cityName = (c: (typeof citySeeds)[number]) => (locale === 'en' && c.nameEn) || c.nameId;
const catName = (c: (typeof categorySeeds)[number]) => (locale === 'en' ? c.nameEn : c.nameId);
const legal = locale === 'en'
  ? [['/terms/', t('footer.terms')], ['/privacy/', t('footer.privacy')], ['/content-policy/', t('footer.content')], ['/anti-trafficking/', t('footer.antitrafficking')]]
  : [['/syarat/', t('footer.terms')], ['/privasi/', t('footer.privacy')], ['/kebijakan-konten/', t('footer.content')], ['/anti-perdagangan-manusia/', t('footer.antitrafficking')]];
---
<footer class="mt-16 border-t border-zinc-200 bg-white text-sm dark:border-zinc-800 dark:bg-zinc-900">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <h2 class="mb-3 font-semibold">{t('footer.cities')}</h2>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">
        {cities.map((city) => (
          <li>
            <a href={localizedPath(locale, `/${city.slug}/`)} class="text-zinc-600 hover:text-brand-600 dark:text-zinc-400">{cityName(city)}</a>
            <span class="text-zinc-400"> · </span>
            {categorySeeds.slice(0, 2).map((cat, i) => (
              <>
                {i > 0 && <span class="text-zinc-400">/</span>}
                <a href={localizedPath(locale, `/${city.slug}/${cat.slug}/`)} class="text-xs text-zinc-500 hover:text-brand-600">{catName(cat)}</a>
              </>
            ))}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="mb-3 font-semibold">{t('footer.categories')}</h2>
      <ul class="space-y-1">
        {categorySeeds.map((cat) => (
          <li><a href={localizedPath(locale, `/${site.defaultCitySlug}/${cat.slug}/`)} class="text-zinc-600 hover:text-brand-600 dark:text-zinc-400">{catName(cat)}</a></li>
        ))}
        <li><a href={localizedPath(locale, '/blog/')} class="text-zinc-600 hover:text-brand-600 dark:text-zinc-400">{t('nav.blog')}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="mb-3 font-semibold">{t('footer.legal')}</h2>
      <ul class="space-y-1">
        {legal.map(([href, label]) => (
          <li><a href={localizedPath(locale, href!)} class="text-zinc-600 hover:text-brand-600 dark:text-zinc-400">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-zinc-200 py-4 text-center text-xs text-zinc-500 dark:border-zinc-800">
    {t('footer.copyright', { year: new Date().getFullYear(), brand: site.name })}
  </div>
</footer>
