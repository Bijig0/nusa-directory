---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import ListingCard from '../components/astro/ListingCard.astro';
import FilterBar from '../components/astro/FilterBar.astro';
import Pagination from '../components/astro/Pagination.astro';
import { translate, localizedPath } from '../domain/i18n';
import { categoryPath, areaPath, cityPath } from '../domain/slug';
import { pageTitleSuffix, type CategoryPage } from '../services/browse.service';
import { site } from '../../site.config';

interface Props { page: CategoryPage }
const { page } = Astro.props;
const { locale, dict } = Astro.locals;
const t = translate(dict);
const origin = (Astro.site ?? new URL(site.url)).origin;
const name = (row: { nameId: string; nameEn: string }) => (locale === 'en' ? row.nameEn : row.nameId);
const cityName = name(page.city);
const pathNoLocale = page.area ? areaPath(page.city.slug, page.category.slug, page.area.slug) : categoryPath(page.city.slug, page.category.slug);
const suffix = pageTitleSuffix(page.pagination.page, locale);
const canonical = `${origin}${page.hrefFor(page.pagination.page)}`;
---
<Base title={page.seo.title + suffix} description={page.seo.description} path={pathNoLocale} canonical={page.indexable ? canonical : undefined} noindex={!page.indexable} jsonLd={page.jsonLd}>
  <Fragment slot="head">
    {page.pagination.hasPrev && <link rel="prev" href={page.hrefFor(page.pagination.page - 1)} />}
    {page.pagination.hasNext && <link rel="next" href={page.hrefFor(page.pagination.page + 1)} />}
  </Fragment>
  <div class="container-page py-6">
    <Breadcrumbs crumbs={page.crumbs.map((c) => ({ ...c, url: c.url.replace(origin, '') }))} />
    <div class="mt-3 flex flex-wrap items-end justify-between gap-2">
      <h1 class="text-2xl font-black tracking-tight sm:text-3xl">{page.seo.h1}{suffix}</h1>
      <span class="text-sm text-zinc-500">{t('browse.results', { count: page.pagination.total })}</span>
    </div>
    {page.pagination.page === 1 && <p class="mt-2 max-w-3xl text-sm text-zinc-600 dark:text-zinc-400">{page.seo.intro}</p>}

    <div class="mt-4">
      <FilterBar filters={page.filters} areas={page.areasWithCounts.map((a) => a.area)} basePath={page.basePath} areaBasePath={page.areaHref} />
    </div>

    <nav class="mt-4 flex gap-2 overflow-x-auto pb-1 text-sm" aria-label={t('browse.areasIn', { city: cityName })}>
      <a href={page.areaHref(undefined)} class={`shrink-0 rounded-full border px-3 py-1 ${!page.area ? 'border-brand-500 bg-brand-50 text-brand-700 dark:bg-brand-900/30' : 'border-zinc-200 dark:border-zinc-700'}`}>{t('browse.allAreas')}</a>
      {page.areasWithCounts.filter((a) => a.count > 0 || a.area.id === page.area?.id).map(({ area, count }) => (
        <a href={page.areaHref(area.slug)} class={`shrink-0 rounded-full border px-3 py-1 ${page.area?.id === area.id ? 'border-brand-500 bg-brand-50 text-brand-700 dark:bg-brand-900/30' : 'border-zinc-200 dark:border-zinc-700'}`}>{name(area)} <span class="text-xs text-zinc-400">{count}</span></a>
      ))}
    </nav>

    {page.items.length === 0 ? (
      <div class="card mt-6 p-10 text-center">
        <p class="font-semibold">{page.hasFilters ? t('browse.noResults') : t('browse.emptyCity', { city: cityName })}</p>
        <p class="mt-1 text-sm text-zinc-500">{page.hasFilters ? t('browse.noResultsHint') : t('browse.emptyCityHint')}</p>
        <a href="/dashboard/listings/new/" class="btn-primary mt-4">{t('browse.postCta', { city: cityName })}</a>
      </div>
    ) : (
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {page.items.map((item, i) => <ListingCard item={item} now={page.now} priority={i < 3} />)}
      </div>
    )}

    <Pagination pagination={page.pagination} hrefFor={page.hrefFor} />

    <section class="mt-12 grid gap-8 border-t border-zinc-200 pt-8 text-sm sm:grid-cols-2 dark:border-zinc-800">
      <div>
        <h2 class="mb-2 font-semibold">{t('browse.otherCategories', { city: cityName })}</h2>
        <ul class="space-y-1">
          {page.otherCategories.map(({ category, count }) => (
            <li><a href={localizedPath(locale, categoryPath(page.city.slug, category.slug))} class="text-zinc-600 hover:text-brand-600 dark:text-zinc-400">{name(category)} {cityName} <span class="text-xs text-zinc-400">({count})</span></a></li>
          ))}
          <li><a href={localizedPath(locale, cityPath(page.city.slug))} class="text-zinc-600 hover:text-brand-600 dark:text-zinc-400">→ {cityName}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-2 font-semibold">{t('browse.otherCities')}</h2>
        <ul class="grid grid-cols-2 gap-1">
          {page.geo.cities.filter((c) => c.id !== page.city.id).slice(0, 16).map((c) => (
            <li><a href={localizedPath(locale, categoryPath(c.slug, page.category.slug))} class="text-zinc-600 hover:text-brand-600 dark:text-zinc-400">{name(page.category)} {name(c)}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>
