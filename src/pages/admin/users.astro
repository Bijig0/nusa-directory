---
import Admin from '../../layouts/Admin.astro';
import AdminForm from '../../components/astro/AdminForm.astro';
import { actions } from 'astro:actions';
import { translate } from '../../domain/i18n';
import { usersList } from '../../infra/db/repos/moderation';
const { dict, deps } = Astro.locals;
const t = translate(dict);
const q = Astro.url.searchParams.get('q')?.trim() || undefined;
const rows = await usersList(deps.db, 100, q);
---
<Admin title={t('admin.users')} active="users">
  <form method="get" class="mb-3 flex gap-2"><input class="input max-w-xs" type="search" name="q" value={q ?? ''} placeholder="+62 / email / nama" /><button class="btn-secondary" type="submit">{t('nav.search')}</button></form>
  <div class="card overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-zinc-50 text-xs text-zinc-500 dark:bg-zinc-800"><tr><th class="p-3">User</th><th class="p-3">Identities</th><th class="p-3">Ads</th><th class="p-3">Status</th><th class="p-3"></th></tr></thead>
      <tbody>
        {rows.map(({ user: u, identities, listingCount }) => (
          <tr class="border-t border-zinc-100 dark:border-zinc-800" data-admin-user={u.id}>
            <td class="p-3">{u.displayName ?? '—'}<br /><span class="text-xs text-zinc-400">{u.id}</span></td><td class="p-3 text-xs">{identities}</td><td class="p-3">{listingCount}</td><td class="p-3">{u.status}</td>
            <td class="p-3"><div class="flex gap-1">{u.status === 'active' ? <AdminForm action={actions.admin.user} fields={{ userId: u.id, action: 'ban', reason: 'admin' }} label={t('admin.ban')} class="btn-ghost text-xs text-red-600" /> : <AdminForm action={actions.admin.user} fields={{ userId: u.id, action: 'unban' }} label={t('admin.unban')} />}<AdminForm action={actions.admin.user} fields={{ userId: u.id, action: 'add_credits' }} label="+5" /></div></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Admin>
