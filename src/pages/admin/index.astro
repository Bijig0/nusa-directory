---
import Admin from '../../layouts/Admin.astro';
import { translate } from '../../domain/i18n';
import { formatIdr } from '../../domain/money';
import { adminKpis } from '../../infra/db/repos/moderation';
const { locale, dict, deps } = Astro.locals;
const t = translate(dict);
const k = await adminKpis(deps.db, deps.clock.now());
const tiles = [
  [t('admin.kpi.active'), k.active, '/admin/listings/?queue=all'], [t('admin.kpi.pending'), k.pending, '/admin/listings/?queue=new'], [t('admin.kpi.reports'), k.openReports, '/admin/reports/'],
  [t('admin.kpi.revenue30'), formatIdr(k.revenue30, locale), '/admin/orders/'], [t('admin.kpi.orders30'), k.paidOrders30, '/admin/orders/'], [t('admin.kpi.users'), k.users, '/admin/users/'],
] as const;
---
<Admin title={t('admin.dashboard')} active="dashboard">
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
    {tiles.map(([label, value, href]) => <a href={href} class="card p-4 hover:border-brand-400"><p class="text-xs text-zinc-500">{label}</p><p class="mt-1 text-2xl font-black" data-kpi={label}>{value}</p></a>)}
  </div>
</Admin>
