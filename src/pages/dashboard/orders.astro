---
import Dashboard from '../../layouts/Dashboard.astro';
import { translate } from '../../domain/i18n';
import { ordersOfWallet } from '../../infra/db/repos/orders';
import { formatIdr } from '../../domain/money';
const { locale, dict, deps, user } = Astro.locals;
const t = translate(dict);
const rows = await ordersOfWallet(deps.db, user!.walletId, 50);
---
<Dashboard title={t('orders.title')} active="orders">
  {rows.length === 0 ? <p class="card p-6 text-sm text-zinc-500">{t('orders.empty')}</p> : (
    <div class="card overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-zinc-50 text-xs text-zinc-500 dark:bg-zinc-800"><tr><th class="p-3">{t('orders.date')}</th><th class="p-3">{t('orders.item')}</th><th class="p-3">{t('orders.amount')}</th><th class="p-3">{t('orders.status')}</th></tr></thead>
        <tbody>{rows.map((o) => <tr class="border-t border-zinc-100 dark:border-zinc-800"><td class="p-3">{o.createdAt.toISOString().slice(0, 10)}</td><td class="p-3">{o.productCode}</td><td class="p-3">{formatIdr(o.amountIdr, locale)}</td><td class="p-3">{t(`orders.status.${o.status}`)}</td></tr>)}</tbody>
      </table>
    </div>
  )}
</Dashboard>
