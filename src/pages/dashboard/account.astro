---
import Dashboard from '../../layouts/Dashboard.astro';
import AuthIsland from '../../components/astro/AuthIsland.astro';
import ProfileForm from '../../components/islands/Account/ProfileForm';
import { translate } from '../../domain/i18n';
import { identitiesOf } from '../../infra/db/repos/auth';
import { walletBalance } from '../../services/device.service';
import { formatPhone } from '../../domain/phone';

const { dict, user, deps } = Astro.locals;
const t = translate(dict);
const ids = await identitiesOf(deps.db, user!.id);
const balance = await walletBalance(deps, user!.walletId);
const has = (p: string) => ids.some((i) => i.provider === p);
const googleEnabled = Boolean(deps.env.GOOGLE_CLIENT_ID);
const adding = Astro.url.searchParams.get('add');
---
<Dashboard title={t('account.title')} active="account">
  <div class="grid gap-4 lg:grid-cols-2">
    <div class="card p-4">
      <ProfileForm client:only="preact" initialName={user!.displayName ?? ''} labels={{ name: t('account.name'), save: t('account.save'), saved: t('account.saved') }} />
      <div class="mt-6">
        <h2 class="text-sm font-semibold text-zinc-500">{t('account.balance')}</h2>
        <p class="text-3xl font-black">{balance}</p>
        <p class="text-xs text-zinc-500">{t('account.balanceHint')}</p>
      </div>
    </div>
    <div class="card p-4">
      <h2 class="mb-2 font-semibold">{t('account.identities')}</h2>
      <ul class="divide-y divide-zinc-200 text-sm dark:divide-zinc-800">
        {ids.map((i) => (
          <li class="flex items-center justify-between py-2">
            <span class="text-zinc-500">{t(`account.provider.${i.provider}`)}</span>
            <span class="font-medium">{i.provider === 'phone' ? formatPhone(i.providerId) : i.provider === 'google' ? (i.email ?? 'Google') : i.providerId}</span>
          </li>
        ))}
      </ul>
      <div class="mt-3 flex flex-wrap gap-2 text-sm">
        {!has('phone') && <a href="?add=wa" class="btn-secondary">{t('account.addPhone')}</a>}
        {!has('email') && <a href="?add=email" class="btn-secondary">{t('account.addEmail')}</a>}
        {googleEnabled && !has('google') && <a href="/auth/google/start?link=1&next=/dashboard/account/" class="btn-secondary" rel="nofollow">{t('account.addGoogle')}</a>}
      </div>
      {(adding === 'wa' || adding === 'email') && (
        <div class="mt-4 border-t border-zinc-200 pt-4 dark:border-zinc-800">
          <AuthIsland next="/dashboard/account/" link initialChannel={adding} />
        </div>
      )}
    </div>
  </div>
</Dashboard>
