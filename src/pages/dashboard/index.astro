---
import Dashboard from '../../layouts/Dashboard.astro';
import ListingActions from '../../components/islands/Account/ListingActions';
import { translate, localizedPath } from '../../domain/i18n';
import { listingPath } from '../../domain/slug';
import { myListings } from '../../services/listing.service';
import { loadGeo, cityById, categoryById } from '../../infra/db/repos/geo';
import { statsTotals } from '../../infra/db/repos/stats';
import { daysUntil } from '../../domain/listing';
import { site } from '../../../site.config';

const { locale, dict, deps, user } = Astro.locals;
const t = translate(dict);
const [items, geo] = await Promise.all([myListings(deps, user!), loadGeo(deps.db)]);
const totals = await statsTotals(deps.db, items.map((l) => l.id));
const totalOf = (id: string) => totals.find((x) => x.listingId === id);
const now = deps.clock.now();
const activeCount = items.filter((l) => l.status === 'active').length;
const statusClass: Record<string, string> = { active: 'bg-emerald-100 text-emerald-700', draft: 'bg-zinc-200 text-zinc-700', paused: 'bg-amber-100 text-amber-800', expired: 'bg-red-100 text-red-700' };
const labels = { pause: t('dl.pause'), resume: t('dl.resume'), renew: t('dl.renew'), remove: t('dl.remove'), confirmRemove: t('dl.confirmRemove') };
---
<Dashboard title={t('dash.listings')} active="listings">
  <p class="mb-3 text-xs text-zinc-500">{t('dl.freeSlots', { used: activeCount, limit: site.freeActiveListings })}</p>
  {items.length === 0 ? (
    <div class="card p-8 text-center">
      <p class="text-sm text-zinc-500">{t('dl.empty')}</p>
      <a href="/dashboard/listings/new/" class="btn-primary mt-4">{t('dash.newListing')}</a>
    </div>
  ) : (
    <ul class="space-y-3">
      {items.map((l) => {
        const city = cityById(geo, l.cityId);
        const category = categoryById(geo, l.categoryId);
        const view = city && category ? localizedPath(locale, listingPath(city.slug, category.slug, l.slug, l.shortId)) : '#';
        const s = totalOf(l.id);
        return (
          <li class="card p-4" data-listing-row={l.id}>
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div class="min-w-0">
                <a href={view} class="font-semibold hover:text-brand-600">{l.title}</a>
                <p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-zinc-500">
                  <span class={`badge ${statusClass[l.status] ?? ''}`}>{t(`dl.status.${l.status}`)}</span>
                  {l.status === 'active' && l.moderation !== 'approved' && <span class="badge bg-amber-50 text-amber-700">{t(`dl.mod.${l.moderation}`)}</span>}
                  {l.expiresAt && l.status === 'active' && <span>{t('dl.expires', { when: `${daysUntil(l.expiresAt, now)}d` })}</span>}
                  <span>{t('dl.photos', { count: l.photoCount })}</span>
                  {s && <span>👁 {s.views} · 🔓 {s.reveals} · 💬 {s.waClicks}</span>}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-1 text-xs">
                <a href={`/dashboard/listings/${l.id}/edit/`} class="btn-ghost text-xs">{t('dl.edit')}</a>
                <a href={`/dashboard/listings/${l.id}/stats/`} class="btn-ghost text-xs">{t('dl.stats')}</a>
                {l.status === 'active' && <a href={`/dashboard/listings/${l.id}/boost/`} class="btn-ghost text-xs text-gold-600">★ {t('dl.boost')}</a>}
                <ListingActions client:only="preact" id={l.id} status={l.status} labels={labels} />
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  )}
</Dashboard>
