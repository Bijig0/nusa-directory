---
import Dashboard from '../../../../layouts/Dashboard.astro';
import { translate } from '../../../../domain/i18n';
import { ownedListing } from '../../../../services/listing.service';
import { statsForListing, jakartaDay } from '../../../../infra/db/repos/stats';
const { dict, deps, user, isAdmin } = Astro.locals;
const t = translate(dict);
const r = await ownedListing(deps, user!, Astro.params.id ?? '', isAdmin);
if (!r.ok) return new Response(null, { status: r.error.kind === 'forbidden' ? 403 : 404 });
const now = deps.clock.now();
const since = jakartaDay(new Date(now.getTime() - 30 * 86_400_000));
const rows = await statsForListing(deps.db, r.value.id, since);
const totals = rows.reduce((a, x) => ({ views: a.views + x.views, reveals: a.reveals + x.reveals, wa: a.wa + x.waClicks, fav: a.fav + x.favorites }), { views: 0, reveals: 0, wa: 0, fav: 0 });
const max = Math.max(1, ...rows.map((x) => x.views));
---
<Dashboard title={`${t('stats.title')} · ${r.value.title}`} active="listings">
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    {[[t('stats.views'), totals.views], [t('stats.reveals'), totals.reveals], [t('stats.wa'), totals.wa], [t('stats.favorites'), totals.fav]].map(([label, n]) => (
      <div class="card p-4"><p class="text-xs text-zinc-500">{label}</p><p class="text-2xl font-black">{n}</p></div>
    ))}
  </div>
  <div class="card mt-4 p-4">
    <h2 class="mb-3 text-sm font-semibold text-zinc-500">{t('stats.last30')}</h2>
    {rows.length === 0 ? <p class="text-sm text-zinc-500">{t('stats.empty')}</p> : (
      <>
        <svg viewBox={`0 0 ${rows.length * 12} 60`} class="h-24 w-full" preserveAspectRatio="none" aria-hidden="true">
          {rows.map((x, i) => <rect x={i * 12 + 1} y={60 - (x.views / max) * 58} width="10" height={(x.views / max) * 58} class="fill-brand-500" />)}
        </svg>
        <table class="mt-3 w-full text-left text-sm">
          <thead class="text-xs text-zinc-500"><tr><th class="py-1">{t('stats.day')}</th><th>{t('stats.views')}</th><th>{t('stats.reveals')}</th><th>{t('stats.wa')}</th><th>{t('stats.favorites')}</th></tr></thead>
          <tbody>{rows.slice().reverse().map((x) => <tr class="border-t border-zinc-100 dark:border-zinc-800"><td class="py-1">{x.day}</td><td>{x.views}</td><td>{x.reveals}</td><td>{x.waClicks}</td><td>{x.favorites}</td></tr>)}</tbody>
        </table>
      </>
    )}
  </div>
</Dashboard>
