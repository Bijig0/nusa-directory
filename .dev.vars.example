# Copy to .dev.vars for local development (wrangler reads it as secrets).
# Secrets in production: `wrangler secret put <NAME>`.

# Random 32+ byte strings. Generate with: openssl rand -base64 48
DEVICE_SECRET=dev-device-secret-change-me-please-0123456789
OTP_PEPPER=dev-otp-pepper-change-me-please-0123456789
SEED_TOKEN=dev-seed-token

# Comma-separated E.164 phones and/or emails that get the admin role on sign-in.
ADMIN_IDENTITIES=+6281200000001,admin@example.com

# Midtrans (https://dashboard.midtrans.com -> Settings -> Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# Fonnte WhatsApp gateway token (https://fonnte.com). Leave empty to log OTPs to the console.
FONNTE_TOKEN=

# Resend (https://resend.com). Leave empty to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM=Nusa Directory <no-reply@example.com>

# Google OAuth 2.0 web client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {PUBLIC_SITE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
